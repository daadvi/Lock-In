<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_adherence_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_nothing_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Bar: Branding + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_adherence_brand_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_widget_accent_button" />

        <TextView
            android:id="@+id/widget_adherence_brand_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="LOCK IN • CONSISTÊNCIA"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_adherence_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="DISCIPLINA"
            android:textColor="#00E676"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Content: Percentage Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_adherence_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_adherence_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="LIMITE RESPEITADO"
            android:textColor="#A0A0A8"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Bottom Row: Streak + Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_adherence_streak_pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Sequência"
                android:src="@drawable/ic_widget_flame" />

            <TextView
                android:id="@+id/widget_adherence_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:text="0 DIAS"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_adherence_action_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_accent_button"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="STATS"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
